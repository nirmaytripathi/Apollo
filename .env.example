# Copy to .env and fill in real values. Never commit .env.

# --- Search (Athena) ---
TAVILY_API_KEY=your-tavily-key
SERPER_API_KEY=your-serper-key

# --- LLM (Apollo planning, Hermes review) ---
# LLM_PROVIDER: "groq" or "gemini"
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Loop control (enforced in code) ---
MAX_ROUNDS=2
TIMEOUT_SECONDS=300
SEARCH_MAX_RETRIES=2
LLM_MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=15
VERIFY_MODEL=openai/gpt-oss-20b
# Fallback chain for planning, review and writing (default: LLM_PROVIDER's model first, then the others)
# LLM_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-3.1-flash-lite
# Claim-verification fallback chain, provider:model in order (each has its own daily quota).
# Leave it unset: the default chain already includes the spare models below. Setting it replaces the whole chain.
# VERIFY_CHAIN=groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,gemini:gemini-3.1-flash-lite
# Spare models with their own free quotas, tried after the main ones (comma-separated, defaults shown)
# GROQ_SPARE_MODELS=qwen/qwen3.8-27b
# GEMINI_SPARE_MODELS=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.5-flash,gemma-4-26b-a4b-it

# --- Specialist source APIs (added on top of web search; all free, no key required) ---
# academic: OpenAlex -> Crossref · health: PubMed -> Europe PMC · statistics: World Bank -> IMF
# news: The Guardian -> Tavily news (uses TAVILY_API_KEY) · tech: GitHub -> Stack Exchange · general: Tavily -> Serper
# DOMAIN_SOURCES=academic,health,statistics,news,tech
# DOMAIN_PAGES_PER_QUERY=2
# MIN_RELEVANCE=0.3
# DOMAIN_RELEVANCE=academic:0.3,health:0.3
# Cache used only when both APIs of a domain fail; days until an entry is stale (kept, marked stale)
# SOURCE_CACHE_TTL_DAYS=academic:30,statistics:7,health:7,news:1,tech:3,general:2
# SOURCE_CACHE_ENABLED=true
# Optional: higher rate limits (OPENALEX_MAILTO also joins the Crossref polite pool)
# OPENALEX_MAILTO=
# OPENALEX_API_KEY=   # free key at openalex.org (Settings); without one, ~100 searches a day
# SEMANTIC_SCHOLAR_API_KEY=
# NCBI_API_KEY=
# GITHUB_TOKEN=
# STACKEXCHANGE_KEY=
# GUARDIAN_API_KEY=   # news primary; free developer key, https://open-platform.theguardian.com/access/

# --- Replay mode: fixed offline answers, no network calls, no keys (tests and demos) ---
# LLM_MODE=live
# REPLAY_SCENARIO=ok   # ok | primary_down | all_down

# --- YouTube links ---
# No captions, or YouTube blocks the server: Gemini transcribes the video (needs GEMINI_API_KEY)
# VIDEO_GEMINI_FALLBACK=true
# VIDEO_TIMEOUT_SECONDS=180
# Gemini transcribes only the first part of a long video (a whole 2-hour lecture timed out):
# VIDEO_MAX_SECONDS=2100
# VIDEO_GEMINI_FPS=0.2

# Optional: USD per 1M tokens, only to show an estimated cost on the Cost & Execution page
PRICE_GROQ_INPUT_PER_M=
PRICE_GROQ_OUTPUT_PER_M=
PRICE_GEMINI_INPUT_PER_M=
PRICE_GEMINI_OUTPUT_PER_M=

# --- Accounts (web app login) ---
# Long random string that signs session tokens, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# JWT_TTL_HOURS=12
# AUTH_DB=output/users.db
# COOKIE_SECURE=false   # set true when the app is served over HTTPS

# --- Database ---
# Neon / Postgres connection string (users and saved runs). Leave empty to use a local SQLite file.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
